# Endereço do Moodle (só a origem)
MOODLE_URL=https://moodle.utfpr.edu.br

# auto = tenta core_course_get_contents e cai para o modo web (a UTFPR bloqueia a API) | api | web
MODE=auto

# Quais disciplinas: inprogress (em andamento) | all | past | future
COURSES=inprogress
# COURSE_IDS=12345,67890         só essas disciplinas (o id está em course/view.php?id=)

# Pasta onde o conteúdo é salvo
OUT_DIR=materias

HEADLESS=false

# Opcionais
# BROWSER_CHANNEL=msedge         usar o Edge/Chrome instalado em vez do Chromium do Playwright
# PROFILE_DIR=.moodle-profile    perfil do navegador (guarda a sessão; trate como senha)
# DELAY_MS=300                   pausa entre downloads
# MAX_FILE_MB=100                arquivos maiores ficam só como link no índice
